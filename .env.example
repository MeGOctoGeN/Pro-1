# MOST-PHARMA-GRO Environment Configuration

# ==============================================
# xAI Grok API Configuration
# ==============================================
# Get your API key from: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Optional: Override default API endpoint
# XAI_API_ENDPOINT=https://api.x.ai/v1/chat/completions

# Optional: Specify Grok model version
# XAI_MODEL=grok-beta

# ==============================================
# Database Configuration
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=most_pharma_gro
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ==============================================
# Redis Configuration (for caching)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# Application Settings
# ==============================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ==============================================
# Payment Gateway Configuration
# ==============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ==============================================
# Email Configuration
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# ==============================================
# Analytics & Ads Configuration
# ==============================================
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y
GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# ==============================================
# Security & Authentication
# ==============================================
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# ==============================================
# AI Assistant Configuration (Optional)
# ==============================================
# Enable/disable AI services
AI_CUSTOMER_QUERY_ENABLED=true
AI_INVENTORY_PREDICTION_ENABLED=true
AI_PRESCRIPTION_ANALYZER_ENABLED=true
AI_HEALTH_ADVICE_ENABLED=true
AI_MARKETING_CONTENT_ENABLED=true

# AI request limits
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_REQUESTS_PER_HOUR=1000

# Privacy settings
AI_ANONYMIZE_DATA=true
AI_PRIVACY_MODE=true

# Debug mode
AI_DEBUG=false

# ==============================================
# IMPORTANT NOTES
# ==============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. Keep your API keys secure and private
# 4. Rotate keys regularly for security
# 5. Use different keys for development and production
